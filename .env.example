# LLM Provider — pick one: gemini, openai, anthropic, ollama, mock
# gemini-2.0-flash is recommended for platform use (cheap + fast)
LLM_PROVIDER=gemini

# Gemini (platform default)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (also works with OpenAI-compatible APIs — set OPENAI_BASE_URL to override)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Ollama (local — no API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Free credits granted to new users on their first AI request (token units)
INITIAL_CREDITS=10000
