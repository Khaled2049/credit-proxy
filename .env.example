# LLM Provider — pick one: gemini, openai, anthropic, ollama, mock
# gemini-2.5-flash-lite is the platform default (cheapest flash tier: ~$0.10/1M in, $0.40/1M out)
LLM_PROVIDER=gemini

# Gemini (platform default)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenAI (also works with OpenAI-compatible APIs — set OPENAI_BASE_URL to override)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Ollama (local — no API key required)
# From inside docker, localhost is the container: use host.docker.internal to
# reach an Ollama running on the host.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Skip credit metering entirely because inference is running on your own
# hardware. Audited in the ledger as local_generate. llmproxy refuses to start
# with this set unless the provider really is Ollama on a local address, so it
# cannot be flipped into free hosted inference. Never set in production —
# Terraform deliberately does not expose it.
LOCAL_UNMETERED=false

# Free credits granted to new users on their first AI request (token units)
INITIAL_CREDITS=10000

# Hard cap on total non-BYOK platform requests per UTC day.
# Prevents exceeding the LLM provider's free-tier daily limit regardless of user count.
# BYOK requests are never counted against this cap.
PLATFORM_DAILY_REQUEST_LIMIT=1400

# Hard cap on total non-BYOK credits the platform will hold per UTC day. A
# request cap alone bounds how many calls are made, not how large they are, so
# capacity is metered in credits too. Charged at reservation with the ceiling
# and reconciled down on commit.
#
# Size it ABOVE the worst case the request cap already allows, or it silently
# becomes the real limit: 1400 requests x ~100 credits (an 8192-token ceiling
# at TOKENS_PER_CREDIT=100) is ~140k, so 150k is a backstop rather than the
# binding constraint.
PLATFORM_DAILY_CREDIT_LIMIT=150000

# Kill switch. false refuses platform-funded inference while leaving BYOK and
# force_mock working, so flipping it degrades the platform instead of taking
# every path down with it.
PLATFORM_INFERENCE_ENABLED=true

# Gateway auth mode:
# - dev: skip GCP caller auth; allow body user_id when Firebase token is missing
# - dev_strict: skip GCP caller auth; require X-Firebase-Token
# - production: require Cloud Run OIDC + X-Firebase-Token
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
# Comma-separated allowlist of caller identities for production OIDC checks.
# Supports service-account email and token `sub` values.
GCP_ALLOWED_CALLER_SA=

# Optional: explicit audience for incoming Cloud Run OIDC token verification.
# If unset, gateway derives audience from request host.
GCP_AUDIENCE=

# Enable the direct credit mint/top-up endpoint (POST /v1/credits/purchase).
# Required for the in-app "Top up credits" flow.
ENABLE_PURCHASE_API=true

# Max successful credit purchases per user per UTC day. Enforced atomically in
# the usage service before any credits are minted.
MAX_PURCHASES_PER_DAY_PER_USER=3

# Shared secret for gateway → llmproxy auth. Set to a random string in production.
# Leave empty in local dev to skip enforcement.
INTERNAL_SERVICE_TOKEN=

# Gateway abuse controls.
MAX_OUTPUT_TOKENS=8192
MAX_PROMPT_CHARS=64000
MAX_REQUESTS_PER_MINUTE_PER_USER=10

# /v1/chat gets its own bucket: one assistant run is several chat calls, so the
# generate limit above would trip on a writer's second question.
MAX_CHAT_REQUESTS_PER_MINUTE_PER_USER=60

# Tokens per credit — the gateway divides real token usage by this to bill
# credits (ceil, min 1). At 100, INITIAL_CREDITS=10000 buys ~1,000,000 tokens.
TOKENS_PER_CREDIT=100
